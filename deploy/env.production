# Copy to /var/www/verda-padel/.env on the server
# NEVER commit this file — .gitignore already excludes .env

VERDA_ENV=production

# Generate a strong secret key with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_STRING

# SQLite (default — fine for a single venue)
DATABASE_URL=sqlite:///verda.db

# MySQL option (install requirements-mysql.txt first):
# DATABASE_URL=mysql://verda:PASSWORD@localhost/verda_padel?charset=utf8mb4
