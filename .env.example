# Copy to .env for this installation. Never commit .env.
VERDA_ENV=development
# Development generates a private instance/.session-secret when omitted.
# Production requires a randomly generated secret of at least 32 bytes.
# SECRET_KEY=replace-with-a-unique-random-secret
DATABASE_URL=sqlite:///verda.db
# Optional original production engine, with requirements-mysql.txt installed:
# DATABASE_URL=mysql://username:password@localhost/verda_padel?charset=utf8mb4
# Never reuse the reference client's database or credentials.
